---
// InteractiveEngine.astro
// Core logic for Magnetic Buttons and Scroll Reveals
---

<script>
  // 1. Scroll Reveals (Intersection Observer) - RUNS EVERYWHERE
  function initReveals() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { rootMargin: '0px 0px -10% 0px' });
    
    // Elements to reveal
    const targets = document.querySelectorAll('.story-node, .story-node-left, .story-node-right, .cinematic-reveal');
    targets.forEach(el => observer.observe(el));
  }

  // 2. High-end Interactions - SKIPPED ON MOBILE
  function initInteractions() {
    if (window.matchMedia("(hover: none)").matches) return;
    
    // Magnetic Elements
    const magnetics = document.querySelectorAll('[data-magnetic]');
    magnetics.forEach((el) => {
      const htmlEl = el as HTMLElement;
      
      htmlEl.addEventListener('mousemove', (e) => {
        const rect = htmlEl.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        
        const distX = e.clientX - centerX;
        const distY = e.clientY - centerY;
        
        htmlEl.style.transform = `translate(${distX * 0.3}px, ${distY * 0.3}px)`;
      });
      
      htmlEl.addEventListener('mouseleave', () => {
        htmlEl.style.transform = `translate(0px, 0px)`;
        htmlEl.style.transition = `transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275)`;
        
        setTimeout(() => {
          htmlEl.style.transition = `transform 0.3s ease`; 
        }, 600);
      });
    });
  }

  function bootstrap() {
    initReveals();
    try {
      initInteractions();
    } catch(e) {
      console.error("Interaction Engine Error:", e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootstrap);
  } else {
    bootstrap();
  }
  document.addEventListener('astro:page-load', bootstrap);
</script>
