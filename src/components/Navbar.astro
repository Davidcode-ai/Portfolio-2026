---
// Navbar.astro
---
<nav 
  id="navbar" 
  class="fixed top-0 left-0 right-0 z-50 border-b border-transparent transition-all duration-300 bg-transparent"
>
  <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
    <!-- Logo -->
    <a href="#" class="font-mono text-accent text-sm font-bold tracking-wider hover:opacity-80 transition-opacity">
      DavidMuñoz<span class="text-text-secondary">@dev</span><span class="animate-blink text-accent">_</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-8 font-mono text-xs text-text-secondary">
      <a href="#" class="nav-link hover:text-accent transition-colors">/home</a>
      <a href="#experience" class="nav-link hover:text-accent transition-colors">/story</a>
      <a href="#projects" class="nav-link hover:text-accent transition-colors">/projects</a>
      <a href="#contact" class="nav-link hover:text-accent transition-colors">/contact</a>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden text-text-secondary hover:text-accent transition-colors p-1" aria-label="Toggle Menu">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
  
  <!-- Mobile Menu -->
  <div 
    id="mobile-menu" 
    class="hidden bg-surface border-t border-border px-6 py-4 flex-col gap-4 font-mono text-sm text-text-secondary"
  >
    <a href="#" class="mobile-link hover:text-accent transition-colors">/home</a>
    <a href="#experience" class="mobile-link hover:text-accent transition-colors">/story</a>
    <a href="#projects" class="mobile-link hover:text-accent transition-colors">/projects</a>
    <a href="#contact" class="mobile-link hover:text-accent transition-colors">/contact</a>
  </div>
</nav>

<script>
  function initNavbar() {
    const navbar = document.getElementById('navbar');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    
    // Handle scroll for navbar styling
    const handleScroll = () => {
      if (window.scrollY > 20) {
        navbar?.classList.add('bg-surface/90', 'backdrop-blur-md', 'border-border');
        navbar?.classList.remove('bg-transparent', 'border-transparent');
      } else {
        navbar?.classList.add('bg-transparent', 'border-transparent');
        navbar?.classList.remove('bg-surface/90', 'backdrop-blur-md', 'border-border');
      }
    };
    
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
    
    // Handle mobile menu toggle
    let isMenuOpen = false;
    const toggleMenu = () => {
      isMenuOpen = !isMenuOpen;
      
      if (isMenuOpen) {
        mobileMenu?.classList.remove('hidden');
        mobileMenu?.classList.add('flex');
      } else {
        mobileMenu?.classList.add('hidden');
        mobileMenu?.classList.remove('flex');
      }
    };
    
    mobileMenuBtn?.addEventListener('click', toggleMenu);
    
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isMenuOpen) toggleMenu();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar);
  } else {
    initNavbar();
  }
  document.addEventListener('astro:page-load', initNavbar);
</script>
