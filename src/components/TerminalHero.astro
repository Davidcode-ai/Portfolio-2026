---
// TerminalHero.astro
---

<section id="hero" class="relative min-h-[90vh] flex flex-col items-center justify-center px-6 pt-24 pb-16">
  <div class="w-full max-w-3xl z-20">
    <!-- Label -->
    <p class="font-mono text-xs text-muted mb-4 text-center tracking-widest uppercase">Full-Stack Developer — Spain</p>

    <!-- Terminal window -->
    <div class="rounded-xl overflow-hidden border border-border shadow-card bg-surface relative group">
      <!-- Title bar -->
      <div class="flex items-center gap-2 px-4 py-3 bg-[#1c1c1e] border-b border-border">
        <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
        <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
        <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
        <span class="flex-1 text-center font-mono text-xs text-muted">bash — david@macbook-pro</span>
      </div>

      <!-- Terminal body -->
      <div class="px-6 py-5 font-mono text-sm leading-relaxed min-h-[320px]">
        <!-- Prompt line -->
        <div class="flex items-center gap-2 mb-1">
          <span class="text-accent font-bold">david@macbook-pro</span>
          <span class="text-muted">~</span>
          <span class="text-text-secondary">$</span>
          <span id="typing-command" class="text-text-primary"></span>
          <span id="cursor-cmd" class="animate-blink text-accent font-bold">▋</span>
        </div>

        <!-- JSON response (hidden until typing finishes) -->
        <div id="terminal-response" class="hidden mt-3">
          <div class="text-muted text-xs mb-2"># HTTP/2 200  content-type: application/json</div>
          <pre id="json-output" class="text-sm leading-6 whitespace-pre-wrap"></pre>
        </div>

        <!-- Second prompt (shown after response) -->
        <div id="second-prompt" class="hidden mt-3 flex items-center gap-2">
          <span class="text-accent font-bold">david@macbook-pro</span>
          <span class="text-muted">~</span>
          <span class="text-text-secondary">$</span>
          <span class="animate-blink text-accent font-bold">▋</span>
        </div>
      </div>
      
      <!-- Glow effect -->
      <div class="absolute inset-0 rounded-xl ring-1 ring-inset ring-white/5 pointer-events-none group-hover:shadow-glow-lg transition-shadow duration-700"></div>
    </div>

    <!-- CTA -->
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href="#projects" class="font-mono text-sm px-6 py-3 rounded-lg bg-accent text-bg font-bold hover:bg-accent-dim transition-all duration-200 hover:shadow-glow">
        explore /projects →
      </a>
      <a href="#experience" class="font-mono text-sm px-6 py-3 rounded-lg border border-border text-text-secondary hover:border-accent hover:text-accent transition-all duration-200">
        git log --story
      </a>
    </div>
  </div>
</section>

<script>
  /**
   * PROFILE_DATA
   * The raw JSON data representing the user's profile.
   * This is what gets syntax highlighted and printed to the terminal.
   */
  const PROFILE_DATA = {
    name: "David Muñoz Valdés",
    role: "Full-Stack Developer Junior",
    location: "Cádiz, Spain",
    status: "Looking for Internship (DAW)",
    target: "1xINTERNET",
    skills: ["Python", "Astro", "SQL", "Make.com"],
    contact: {
      email: "davidmv030306@gmail.com",
      github: "github.com/Davidcode-ai"
    }
  };

  // Basic JSON syntax highlighter
  /**
   * syntaxHighlight
   * @param {string} json - The raw JSON string to be highlighted.
   * @returns {string} HTML string with spans applying color classes.
   * 
   * Uses Regex to parse JSON and wrap keys, strings, booleans, and numbers
   * in span tags with corresponding Tailwind/CSS classes for styling.
   */
  function syntaxHighlight(json: string) {
    json = json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    return json.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g, function (match) {
      let cls = 'json-num';
      if (/^"/.test(match)) {
        if (/:$/.test(match)) {
          cls = 'json-key';
        } else {
          cls = 'json-str';
        }
      } else if (/true|false/.test(match)) {
        cls = 'json-bool';
      } else if (/null/.test(match)) {
        cls = 'json-null';
      }
      return '<span class="' + cls + '">' + match + '</span>';
    });
  }

  /**
   * initTerminal
   * Initializes the typing effect on the terminal window.
   */
  function initTerminal() {
    const typingCommand = document.getElementById('typing-command');
    const cursorCmd = document.getElementById('cursor-cmd');
    const terminalResponse = document.getElementById('terminal-response');
    const jsonOutput = document.getElementById('json-output');
    const secondPrompt = document.getElementById('second-prompt');

    if (!typingCommand || !jsonOutput) return;

    // Reset state for Astro view transitions
    typingCommand.textContent = '';
    terminalResponse?.classList.add('hidden');
    secondPrompt?.classList.add('hidden');
    cursorCmd?.classList.remove('hidden');

    const command = 'curl -X GET https://api.davidcode.dev/v1/profile';
    let i = 0;

    function typeText() {
      if (!typingCommand) return;
      if (i < command.length) {
        typingCommand.textContent += command.charAt(i);
        i++;
        setTimeout(typeText, Math.random() * 10 + 5); // 5-15ms
      } else {
        setTimeout(revealResponse, 300); // Simulate network latency
      }
    }

    function revealResponse() {
      cursorCmd?.classList.add('hidden');
      if (terminalResponse && jsonOutput && secondPrompt) {
        terminalResponse.classList.remove('hidden');
        const jsonStr = JSON.stringify(PROFILE_DATA, null, 2);
        jsonOutput.innerHTML = syntaxHighlight(jsonStr);
        secondPrompt.classList.remove('hidden');
      }
    }

    // Start
    setTimeout(typeText, 600);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTerminal);
  } else {
    initTerminal();
  }
  document.addEventListener('astro:page-load', initTerminal);
</script>
